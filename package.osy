// Osysharp.Localization — the app's words and its data in every language it speaks, looked after at a desk: what is
// not translated yet, what went stale when its source changed, and a staff override of any word that survives every
// recompile. The checked-in `locales/<language>.osy` files stay the base; this is where people change them after.
package Osysharp.Localization {
  version "0.3.0";
  minPlatform "0.14.0";
  summary     "a translator's desk: untranslated and stale words and data in every language, and overrides that survive a recompile.";
  model "model/**/*.osy";
  use Osysharp.Ui;
  tests "tests";
}
